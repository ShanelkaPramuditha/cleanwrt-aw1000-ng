#!/bin/sh
# Clean up after apps this fork no longer ships: Passwall, Passwall 2, HomeProxy and
# Adblock. AdGuard Home and the p910nd printer share are optional installs instead
# (docs/install-apps.md): their settings are KEPT, so installing them again after a
# firmware upgrade brings them back as they were - and DNS is put back on dnsmasq when
# AdGuard Home is not installed (see the end of this script).
#
# A keep-settings sysupgrade from an image that carried them keeps their files in
# /etc/config, and the firewall keeps the include sections Passwall wrote for itself.
# Those includes point at scripts that no longer exist, so every firewall reload logs
# an error. Each app is handled only when its init script is absent, which means the
# app is not installed. Someone who installs one of them again keeps its settings.
# A router that never had them finds nothing to do. Runs once.

changed_fw=0

drop_app() { # <init script name> <uci config> [<extra file or dir> ...]
	app=$1; cfg=$2; shift 2
	[ -x "/etc/init.d/$app" ] && return 0
	if [ -f "/etc/config/$cfg" ]; then
		rm -f "/etc/config/$cfg"
		logger -t cw-firstboot "removed /etc/config/$cfg ($app is not in this image)"
	fi
	for extra in "$@"; do
		[ -e "$extra" ] || continue
		rm -rf "$extra"
		logger -t cw-firstboot "removed $extra ($app is not in this image)"
	done
}

drop_fw_include() { # <init script name> <firewall section> ...
	app=$1; shift
	[ -x "/etc/init.d/$app" ] && return 0
	for sec in "$@"; do
		[ "$(uci -q get "firewall.$sec")" = "include" ] || continue
		uci -q delete "firewall.$sec"
		changed_fw=1
		logger -t cw-firstboot "removed firewall include $sec ($app is not in this image)"
	done
}

drop_app passwall    passwall
drop_app passwall2   passwall2
drop_app homeproxy   homeproxy
drop_app adblock     adblock

drop_fw_include passwall  passwall passwall_server
drop_fw_include passwall2 passwall2 passwall2_server

[ "$changed_fw" = 1 ] && uci commit firewall

# Footstrap, the previous default theme, is not in the image any more. Its settings and the
# background files the image put next to them have nothing left to read them; LuCI itself
# moves to Vantage (96-cw-default-theme).
if [ ! -d /www/luci-static/footstrap ]; then
	for left in /etc/config/footstrap /etc/footstrap; do
		[ -e "$left" ] || continue
		rm -rf "$left"
		logger -t cw-firstboot "removed $left (Footstrap is not in this image)"
	done
fi

# DNS without AdGuard Home. Its setup moves dnsmasq off port 53 (to 54) so AdGuard Home can
# answer there. A firmware upgrade drops the installed app but keeps that dnsmasq setting,
# which would leave nothing on port 53: every name lookup fails, on the router and the LAN,
# and `apk` cannot even reinstall the app. So while AdGuard Home is not installed, dnsmasq
# goes back to 53. Its own settings stay; reinstalling it means moving dnsmasq again
# (docs/install-apps.md, AdGuard Home step 2).
if [ ! -x /etc/init.d/adguardhome ]; then
	port=$(uci -q get dhcp.@dnsmasq[0].port)
	if [ -n "$port" ] && [ "$port" != 53 ]; then
		uci -q delete dhcp.@dnsmasq[0].port
		uci -q commit dhcp
		logger -t cw-firstboot "dnsmasq back on port 53 (it was on $port, and AdGuard Home is not installed)"
	fi
fi
exit 0
