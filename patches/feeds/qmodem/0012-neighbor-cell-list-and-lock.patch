+# CleanWRT: the serving cell(s) and the operator, for the Neighbor Cell tab.
+# Adds "operator" and a "serving" array to the open neighborcell object.
+#   +QENG: "servingcell",<state>,"LTE",<is_tdd>,<MCC>,<MNC>,<cellID>,<PCID>,<earfcn>,<band>,<ul_bw>,<dl_bw>,<TAC>,<RSRP>,<RSRQ>,<RSSI>,<SINR>,...
+#   +QENG: "servingcell",<state>,"NR5G-SA",<duplex>,<MCC>,<MNC>,<cellID>,<PCID>,<TAC>,<ARFCN>,<band>,<NR_DL_bw>,<RSRP>,<RSRQ>,<SINR>,<scs>,...
+#   EN-DC: +QENG: "LTE",<is_tdd>,<MCC>,<MNC>,<cellID>,<PCID>,<earfcn>,<band>,<ul_bw>,<dl_bw>,<TAC>,<RSRP>,<RSRQ>,<RSSI>,<SINR>,...
+#          +QENG: "NR5G-NSA",<MCC>,<MNC>,<PCID>,<RSRP>,<SINR>,<RSRQ>,<ARFCN>,<band>,<NR_DL_bw>,...,<scs>(16)
+get_neighborcell_serving_qualcomm(){
+    local response line operator
+    operator=$(cmd_cops_query "$at_port" | grep "+COPS:" | awk -F'"' '{print $2}')
+    json_add_string "operator" "$operator"
+    response=$(cmd_qeng_servingcell "$at_port" | grep "+QENG:" | tr -d '\r')
+    json_add_array "serving"
+    # read from a here-document, not a pipe: a piped loop runs in a subshell
+    # and the rows it adds would never reach the reply
+    while read line; do
+        [ -z "$line" ] && continue
+        line=$(echo "$line" | sed 's/+QENG: //' | tr -d '"')
+        f() { echo "$line" | awk -F',' -v n="$1" '{print $n}'; }
+        case "$line" in
+            servingcell,*,LTE,*)
+                _nc_serving "LTE" "$(f 5)" "$(f 6)" "$(f 7)" "$(f 13)" "$(f 8)" "$(f 9)" "$(f 10)" "$(f 14)" "$(f 15)" "$(f 17)" ""
+                ;;
+            servingcell,*,NR5G-SA,*)
+                _nc_serving "NR" "$(f 5)" "$(f 6)" "$(f 7)" "$(f 9)" "$(f 8)" "$(f 10)" "$(f 11)" "$(f 13)" "$(f 14)" "$(f 15)" "$(f 16)"
+                ;;
+            LTE,*)
+                _nc_serving "LTE" "$(f 3)" "$(f 4)" "$(f 5)" "$(f 11)" "$(f 6)" "$(f 7)" "$(f 8)" "$(f 12)" "$(f 13)" "$(f 15)" ""
+                ;;
+            NR5G-NSA,*)
+                _nc_serving "NR" "$(f 2)" "$(f 3)" "" "" "$(f 4)" "$(f 8)" "$(f 9)" "$(f 5)" "$(f 7)" "$(f 6)" "$(f 16)"
+                ;;
+        esac
+    done <<EOF
+$response
+EOF
+    json_close_array
+}
+
+# rat mcc mnc cellid tac pci arfcn band rsrp rsrq sinr scs
+_nc_serving(){
+    # a cell that is not reported (PCI "-" or empty) is left out
+    case "$6" in ""|"-") return ;; esac
+    json_add_object ""
+    json_add_string "rat" "$1"
+    json_add_string "mcc" "$2"
+    json_add_string "mnc" "$3"
+    json_add_string "cellid" "$4"
+    json_add_string "tac" "$5"
+    json_add_string "pci" "$6"
+    json_add_string "arfcn" "$7"
+    json_add_string "band" "$8"
+    json_add_string "rsrp" "$9"
+    json_add_string "rsrq" "${10}"
+    json_add_string "sinr" "${11}"
+    json_add_string "scs" "${12}"
+    json_close_object
+}
