+	function qmNum(v) {
+		if (v == null || v === '' || v === '-') return NaN;
+		return Number(v);
+	}
+
+	function qmLteInfo(earfcn) {
+		const n = qmNum(earfcn);
+		for (const b of QM_LTE_BANDS) {
+			if (n >= b[1] && n <= b[2]) {
+				return { band: b[0], mhz: Math.round((b[3] + 0.1 * (n - b[1])) * 10) / 10 };
+			}
+		}
+		return { band: null, mhz: null };
+	}
+
+	function qmNrMhz(arfcn) {
+		const n = qmNum(arfcn);
+		if (isNaN(n)) return null;
+		let mhz;
+		if (n < 600000) mhz = n * 0.005;
+		else if (n < 2016667) mhz = 3000 + 0.015 * (n - 600000);
+		else mhz = 24250.08 + 0.06 * (n - 2016667);
+		return Math.round(mhz * 100) / 100;
+	}
+
+	function qmNrGuess(mhz) {
+		for (const b of QM_NR_BANDS) {
+			if (mhz >= b[1] && mhz <= b[2]) return { band: b[0], scs: b[3] };
+		}
+		return null;
+	}
+
+	// SCS as the lock command numbers it: 0 = 15 kHz, 1 = 30, 2 = 60, 3 = 120
+	const QM_SCS = { 15: 0, 30: 1, 60: 2, 120: 3 };
+
+	function qmLevel(rsrp) {
+		const v = qmNum(rsrp);
+		if (isNaN(v)) return 0;
+		if (v >= -80) return 4;
+		if (v >= -90) return 3;
+		if (v >= -100) return 2;
+		if (v >= -110) return 1;
+		return 0;
+	}
