--- a/luci-app-3ginfo-lite/htdocs/luci-static/resources/view/modem/3gdetail.js
+++ b/luci-app-3ginfo-lite/htdocs/luci-static/resources/view/modem/3gdetail.js
@@ -516,6 +516,21 @@
 	});
 }
 
+// CleanWRT: a link to QModem's Neighbor Cell tab with this cell filled in, to lock to it
+function lockLink(cell) {
+	if (num(cell.pci) === null || num(cell.channel) === null)
+		return el('span', { 'class': 'tg-muted' }, '—');
+
+	var url = L.url('admin/modem/qmodem/modem_debug') + '?tab=NeighborCell&rat=%s&pci=%s&arfcn=%s'
+		.format(cell.rat === 'nr' ? 'NR' : 'LTE', encodeURIComponent(cell.pci), encodeURIComponent(cell.channel));
+
+	return el('a', {
+		'class': 'tg-lock-link',
+		'href': url,
+		'title': _('Open Advance Modem Settings with this cell filled in, to lock the modem to it')
+	}, _('Lock…'));
+}
+
 function neighbourCard(cell) {
 	var q = quality('rsrp', cell.rsrp);
 	var channel = cell.rat === 'nr' ? _('NR-ARFCN') : _('EARFCN');
@@ -530,7 +545,8 @@
 			el('div', {}, [ el('dt', {}, _('RSRP')), el('dd', {}, num(cell.rsrp) !== null ? shown(cell.rsrp) + ' dBm' : '—') ]),
 			el('div', {}, [ el('dt', {}, _('RSRQ')), el('dd', {}, num(cell.rsrq) !== null ? shown(cell.rsrq) + ' dB' : '—') ]),
 			el('div', {}, [ el('dt', {}, _('Type')), el('dd', {}, neighbourType(cell.type)) ])
-		])
+		]),
+		el('div', { 'class': 'tg-neighbour-lock' }, [ lockLink(cell) ])
 	]);
 }
 
@@ -545,7 +561,8 @@
 		el('td', {}, num(cell.rsrq) !== null ? shown(cell.rsrq) + ' dB' : '—'),
 		el('td', {}, num(cell.sinr) !== null ? shown(cell.sinr) + ' dB' : '—'),
 		el('td', {}, cell.cell_id != null ? String(cell.cell_id) : _('Not reported')),
-		el('td', {}, neighbourType(cell.type))
+		el('td', {}, neighbourType(cell.type)),
+		el('td', {}, lockLink(cell))
 	]);
 }
 
@@ -717,7 +734,8 @@
