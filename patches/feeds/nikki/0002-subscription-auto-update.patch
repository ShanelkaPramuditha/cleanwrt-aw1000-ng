+# CleanWRT: one cron line per subscription with auto_update=1, every
+# auto_update_interval hours (1, 2, 3, 6, 12; 24 is once a day at 04:23).
+add_subscription_cron() {
+	local section="$1" auto_update interval spec
+	config_get_bool auto_update "$section" "auto_update" 0
+	[ "$auto_update" = 1 ] || return 0
+	config_get interval "$section" "auto_update_interval" "24"
+	case "$interval" in
+		1|2|3|6|12) spec="23 */$interval * * *" ;;
+		*) spec="23 4 * * *" ;;
+	esac
+	log "App" "Set subscription auto update: $section, every $interval hour(s)."
+	echo "$spec /etc/init.d/nikki auto_update_subscription $section #nikki subscription auto update" >> "/etc/crontabs/root"
+}
+
+# CleanWRT: the cron job's update. A subscription that is not in use is only
+# downloaded. The one in use is downloaded and Nikki restarted to run it, but
+# only when the download succeeded; with "Prefer: Remote" the restart itself
+# downloads it, so it is not downloaded twice.
+auto_update_subscription() {
+	local section="$1" profile enabled prefer in_use
+	[ -n "$section" ] || return 0
+	config_load nikki
+	config_get profile "config" "profile"
+	config_get_bool enabled "config" "enabled" 0
+	config_get prefer "$section" "prefer" "remote"
+	in_use=0
+	if [ "$profile" = "subscription:$section" ] && [ "$enabled" = 1 ] && [ -f "$STARTED_FLAG_PATH" ]; then
+		in_use=1
+	fi
+	if [ "$in_use" = 1 ] && [ "$prefer" = "remote" ]; then
+		log "Profile" "Scheduled update of the subscription in use: restart."
+		/etc/init.d/nikki restart
+		return 0
+	fi
+	update_subscription "$section"
+	if [ "$in_use" = 1 ] && [ "$(uci -q get "nikki.$section.success")" = 1 ]; then
+		log "Profile" "Scheduled update of the subscription in use: restart to use it."
+		/etc/init.d/nikki restart
+	fi
+}
+
 update_subscription() {
 	local subscription_section; subscription_section="$1"
 	if [ -z "$subscription_section" ]; then
