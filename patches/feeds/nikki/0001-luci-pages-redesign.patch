+// lines drawn at most; the rest stays in the file (Download has it all)
+const MAX_LINES = 1500;
+
+const coreRe = /^time="([^"]+)"\s+level=(\w+)\s+msg="((?:[^"\\]|\\.)*)"/;
+const appRe = /^\[([^\]]+)\]\s+\[([^\]]+)\]\s+(.*)$/;
+const badRe = /\b(fail(ed|ure)?|error|invalid|not valid|not found|exit)\b/i;
+
+function shortTime(t) {
+    // "2026-11-24T10:00:00.123+08:00" or "2026-11-24 10:00:00" -> "11-24 10:00:00"
+    const m = String(t).match(/^\d{4}-(\d\d-\d\d)[T ](\d\d:\d\d:\d\d)/);
+    return m ? m[1] + ' ' + m[2] : t;
+}
+
+function parseLine(line) {
+    let m = line.match(coreRe);
+    if (m) {
+        const level = m[2].toLowerCase();
+        let cls = '';
+        if (level === 'error' || level === 'fatal' || level === 'panic') {
+            cls = 'is-err';
+        } else if (level === 'warning' || level === 'warn') {
+            cls = 'is-warn';
+        } else if (level === 'debug') {
+            cls = 'is-debug';
+        }
+        return { time: m[1], tag: level, msg: m[3].replace(/\\(["\\])/g, '$1'), cls: cls };
+    }
+    m = line.match(appRe);
+    if (m) {
+        return { time: m[1], tag: m[2], msg: m[3], cls: badRe.test(m[3]) ? 'is-err' : '' };
+    }
+    return { raw: line, cls: badRe.test(line) ? 'is-err' : '' };
