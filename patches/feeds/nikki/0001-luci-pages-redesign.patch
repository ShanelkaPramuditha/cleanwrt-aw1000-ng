+    // "12.5 GB" (the backend's format_filesize) -> bytes, for the usage meter
+    parseSize: function (text) {
+        const m = String(text ?? '').trim().match(/^([\d.]+)\s*([KMGTP]?B)$/i);
+        if (!m) {
+            return null;
+        }
+        const units = { B: 0, KB: 1, MB: 2, GB: 3, TB: 4, PB: 5 };
+        return parseFloat(m[1]) * Math.pow(1024, units[m[2].toUpperCase()]);
+    },
+
+    saveBlob: function (blob, filename) {
