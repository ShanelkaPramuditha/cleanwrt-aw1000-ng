+        if (running) {
+            return { cls: 'is-ok', text: _('Running'), hint: _('The mihomo core is running.') };
+        }
+        if (enabled) {
+            return { cls: 'is-err', text: _('Stopped'), hint: _('Nikki is enabled but the core is not running. The Logs page shows why.') };
+        }
+        return { cls: '', text: _('Disabled'), hint: _('Nikki is turned off. Enable it on the Overview page.') };
+    },
+
+    updateStatusPills: function (running) {
+        const state = this.statusState(running);
+        document.querySelectorAll('.nk-status-pill').forEach(function (node) {
+            node.className = 'nk-pill nk-status-pill ' + state.cls;
+            node.textContent = state.text;
+            node.title = state.hint;
+        });
+        document.querySelectorAll('[data-nk-when-running]').forEach(function (node) {
+            node.disabled = !running;
+        });
+    },
+
+    // The heading every Nikki page opens with: title, live status, the actions
+    // people reach for most, and a line saying what the page is for.
+    renderHeader: function (title, description, running, extraActions) {
+        const self = this;
+        const state = this.statusState(running);
+
+        if (!this._statusPolling) {
