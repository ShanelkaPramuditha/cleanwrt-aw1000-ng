+    handleOpenDashboard: function () {
+        return this.openDashboard().catch(function (err) {
+            ui.addTimeLimitedNotification(null, E('p', [
+                _('The dashboard cannot be opened: %s').format(err?.message ?? err),
+                ' ',
+                _('Nikki must be running, and the profile (or Mixin → Dashboard & API) must set an API address.')
