+/*
+ * Nikki pages: the shared surface (status header, tiles, profile list,
+ * editor and log viewer).
+ *
+ * This is a page surface, not a theme. Colour, type, spacing and radii come
+ * from the active LuCI theme: Vantage's --v-* tier first, then the Bootstrap
+ * colour tokens other themes export, then literals that keep the page
+ * readable on a theme that publishes neither.
+ */
+
+.nk-page {
+	--nk-bg: var(--v-surface, var(--background-color-high, #fff));
+	--nk-bg-soft: var(--v-surface-2, var(--background-color-low, #f6f8fa));
+	--nk-bg-sunk: var(--v-surface-3, var(--background-color-medium, #eef1f4));
+	--nk-text: var(--v-text, var(--text-color-highest, #1f2328));
+	--nk-dim: var(--v-text-2, var(--text-color-medium, #57606a));
+	--nk-faint: var(--v-text-3, var(--text-color-low, #8c959f));
+	--nk-line: var(--v-line, var(--border-color-medium, #d0d7de));
+	--nk-accent: var(--v-accent-text, var(--primary-color-high, #0969da));
+	--nk-accent-soft: var(--v-accent-soft, var(--primary-color-low, #ddf4ff));
+	--nk-ok: var(--v-ok-text, var(--success-color-high, #197c36));
+	--nk-ok-dot: var(--v-ok, var(--success-color-medium, #2da44e));
+	--nk-ok-soft: var(--v-ok-soft, var(--success-color-low, #dafbe1));
+	--nk-warn: var(--v-warn-text, var(--warn-color-high, #946300));
+	--nk-warn-dot: var(--v-warn, var(--warn-color-medium, #d4a72c));
+	--nk-warn-soft: var(--v-warn-soft, var(--warn-color-low, #fff8c5));
+	--nk-err: var(--v-err-text, var(--error-color-high, #cf222e));
+	--nk-err-dot: var(--v-err, var(--error-color-medium, #e5534b));
+	--nk-err-soft: var(--v-err-soft, var(--error-color-low, #ffebe9));
+	--nk-mono: var(--v-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
+	--nk-r: var(--v-r, 6px);
+	--nk-r-lg: var(--v-r-lg, 8px);
+	--nk-gap: var(--v-sp-4, 16px);
+	--nk-sp: var(--v-sp-2, 8px);
+	--nk-fs-sm: var(--v-fs-sm, 12px);
+	--nk-fs-base: var(--v-fs-base, 13px);
+	--nk-fs-lg: var(--v-fs-lg, 16px);
+	--nk-fs-xl: var(--v-fs-xl, 20px);
+	--nk-ctl-h: var(--v-ctl-h, 34px);
+
+	min-width: 0;
+	color: var(--nk-text);
+}
+
+.nk-page *,
+.nk-page *::before,
+.nk-page *::after { box-sizing: border-box; }
+
+/* ------------------------------------------------------------ header */
+
+.nk-header {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: space-between;
+	gap: var(--nk-gap);
+	margin: 0 0 var(--nk-gap);
+}
+.nk-header-main { min-width: 0; flex: 1 1 320px; }
+.nk-header-title {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--nk-sp) 12px;
+	margin: 0;
+	font-size: var(--nk-fs-xl);
+	font-weight: 600;
+	line-height: 1.3;
+	color: var(--nk-text);
+}
+.nk-header-desc {
+	margin: 4px 0 0;
+	max-width: 72ch;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-base);
+	line-height: 1.5;
+}
+.nk-header-desc a { color: var(--nk-accent); }
+.nk-header-actions {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--nk-sp);
+}
+.nk-header-actions .btn,
+.nk-actions .btn { margin: 0 !important; }
+
+/* status pill: a dot and a word, coloured by state */
+.nk-pill {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	height: 24px;
+	padding: 0 10px;
+	border-radius: 999px;
+	background: var(--nk-bg-sunk);
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-sm);
+	font-weight: 600;
+	line-height: 1;
+	white-space: nowrap;
+	vertical-align: middle;
+}
+.nk-pill::before {
+	content: "";
+	width: 8px;
+	height: 8px;
+	border-radius: 50%;
+	background: currentColor;
+	opacity: .9;
+}
+.nk-pill.is-ok { background: var(--nk-ok-soft); color: var(--nk-ok); }
+.nk-pill.is-ok::before { background: var(--nk-ok-dot); box-shadow: 0 0 0 3px color-mix(in srgb, var(--nk-ok-dot) 25%, transparent); }
+.nk-pill.is-err { background: var(--nk-err-soft); color: var(--nk-err); }
+.nk-pill.is-err::before { background: var(--nk-err-dot); }
+.nk-pill.is-warn { background: var(--nk-warn-soft); color: var(--nk-warn); }
+.nk-pill.is-warn::before { background: var(--nk-warn-dot); }
+.nk-pill.is-plain::before { display: none; }
+
+/* small inline badge (Active, Placeholder, Failed) */
+.nk-badge {
+	display: inline-flex;
+	align-items: center;
+	height: 20px;
+	padding: 0 7px;
+	border-radius: var(--nk-r);
+	background: var(--nk-bg-sunk);
+	color: var(--nk-dim);
+	font-size: 11px;
+	font-weight: 600;
+	letter-spacing: .02em;
+	white-space: nowrap;
+	vertical-align: middle;
+}
+.nk-badge.is-accent { background: var(--nk-accent-soft); color: var(--nk-accent); }
+.nk-badge.is-ok { background: var(--nk-ok-soft); color: var(--nk-ok); }
+.nk-badge.is-warn { background: var(--nk-warn-soft); color: var(--nk-warn); }
+.nk-badge.is-err { background: var(--nk-err-soft); color: var(--nk-err); }
+
+/* ------------------------------------------------------------ cards */
+
+.nk-card {
+	margin: 0 0 var(--nk-gap);
+	padding: var(--v-card-py, 16px) var(--v-card-px, 20px);
+	border: 1px solid var(--nk-line);
+	border-radius: var(--nk-r-lg);
+	background: var(--nk-bg);
+}
+.nk-card-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: space-between;
+	gap: var(--nk-sp);
+	margin: 0 0 12px;
+}
+.nk-card-title {
+	margin: 0;
+	font-size: var(--v-fs-md, 14px);
+	font-weight: 600;
+	color: var(--nk-text);
+}
+.nk-card-sub {
+	margin: 2px 0 0;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-sm);
+	line-height: 1.5;
+}
+.nk-actions {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--nk-sp);
+}
+
+/* ------------------------------------------------------------ tiles */
+
+.nk-tiles {
+	display: grid;
+	grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+	gap: 1px;
+	margin: 0 0 var(--nk-gap);
+	border: 1px solid var(--nk-line);
+	border-radius: var(--nk-r-lg);
+	background: var(--nk-line);
+	overflow: hidden;
+}
+.nk-tile {
+	min-width: 0;
+	padding: 14px var(--v-card-px, 20px);
+	background: var(--nk-bg);
+}
+.nk-tile-label {
+	margin: 0 0 6px;
+	color: var(--nk-faint);
+	font-size: 11px;
+	font-weight: 600;
+	letter-spacing: .06em;
+	text-transform: uppercase;
+}
+.nk-tile-value {
+	overflow: hidden;
+	color: var(--nk-text);
+	font-size: var(--nk-fs-lg);
+	font-weight: 600;
+	line-height: 1.35;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.nk-tile-value.is-muted { color: var(--nk-faint); font-weight: 500; }
+.nk-tile-note {
+	margin: 4px 0 0;
+	overflow: hidden;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-sm);
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+.nk-tile-note a { color: var(--nk-accent); }
+
+/* ------------------------------------------------------------ setup steps */
+
+.nk-steps {
+	display: grid;
+	grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+	gap: 12px;
+	margin: 0;
+	padding: 0;
+	list-style: none;
+	counter-reset: nk-step;
+}
+.nk-step {
+	position: relative;
+	display: flex;
+	flex-direction: column;
+	gap: 8px;
+	min-width: 0;
+	margin: 0;
+	padding: 14px 14px 14px 52px;
+	border: 1px solid var(--nk-line);
+	border-radius: var(--nk-r-lg);
+	background: var(--nk-bg-soft);
+	counter-increment: nk-step;
+}
+.nk-step::before {
+	content: counter(nk-step);
+	position: absolute;
+	top: 14px;
+	left: 14px;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	width: 26px;
+	height: 26px;
+	border: 2px solid var(--nk-line);
+	border-radius: 50%;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-sm);
+	font-weight: 700;
+}
+.nk-step.is-done::before {
+	content: "\2713";
+	border-color: var(--nk-ok-dot);
+	background: var(--nk-ok-dot);
+	color: #fff;
+}
+.nk-step-title { margin: 3px 0 0; font-weight: 600; color: var(--nk-text); }
+.nk-step.is-done .nk-step-title { color: var(--nk-dim); }
+.nk-step-text { margin: 0; color: var(--nk-dim); font-size: var(--nk-fs-sm); line-height: 1.5; }
+.nk-step .btn { align-self: flex-start; margin: 0 !important; }
+
+/* ------------------------------------------------------------ notices */
+
+.nk-note {
+	display: flex;
+	gap: 10px;
+	margin: 0 0 var(--nk-gap);
+	padding: 10px 14px;
+	border: 1px solid var(--nk-line);
+	border-left: 3px solid var(--nk-accent);
+	border-radius: var(--nk-r);
+	background: var(--nk-bg-soft);
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-base);
+	line-height: 1.5;
+}
+.nk-note strong { color: var(--nk-text); }
+.nk-note.is-warn { border-left-color: var(--nk-warn-dot); }
+.nk-note.is-err { border-left-color: var(--nk-err-dot); }
+.nk-note code { font-family: var(--nk-mono); font-size: .95em; }
+
+/* ------------------------------------------------------------ profile files */
+
+.nk-drop {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: space-between;
+	gap: 12px;
+	margin: 0 0 12px;
+	padding: 14px 16px;
+	border: 1.5px dashed var(--nk-line);
+	border-radius: var(--nk-r-lg);
+	background: var(--nk-bg-soft);
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-base);
+	transition: border-color .15s, background-color .15s;
+}
+.nk-drop strong { color: var(--nk-text); }
+.nk-drop.is-over {
+	border-color: var(--nk-accent);
+	background: var(--nk-accent-soft);
+}
+.nk-drop input[type="file"] { display: none; }
+
+.nk-files { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
+.nk-file {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr) auto;
+	align-items: center;
+	gap: 8px 16px;
+	padding: 10px 0;
+	border-top: 1px solid var(--nk-line);
+}
+.nk-file:first-child { border-top: 0; }
+.nk-file-name {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 8px;
+	min-width: 0;
+	font-weight: 600;
+	color: var(--nk-text);
+	word-break: break-all;
+}
+.nk-file-meta { margin: 2px 0 0; color: var(--nk-faint); font-size: var(--nk-fs-sm); }
+.nk-file .nk-actions { justify-content: flex-end; }
+.nk-file .btn { margin: 0 !important; }
+.nk-empty {
+	margin: 0;
+	padding: 18px 0 6px;
+	color: var(--nk-dim);
+	text-align: center;
+	font-size: var(--nk-fs-base);
+}
+
+/* subscription usage meter */
+.nk-meter { min-width: 120px; }
+.nk-meter-bar {
+	height: 6px;
+	margin: 0 0 4px;
+	border-radius: 3px;
+	background: var(--nk-bg-sunk);
+	overflow: hidden;
+}
+.nk-meter-bar > span {
+	display: block;
+	height: 100%;
+	border-radius: 3px;
+	background: var(--v-meter, var(--nk-accent));
+}
+.nk-meter.is-warn .nk-meter-bar > span { background: var(--nk-warn-dot); }
+.nk-meter.is-err .nk-meter-bar > span { background: var(--nk-err-dot); }
+.nk-meter-text { color: var(--nk-dim); font-size: var(--nk-fs-sm); white-space: nowrap; }
+.nk-sub-name { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-weight: 600; }
+.nk-dim { color: var(--nk-dim); font-size: var(--nk-fs-sm); }
+
+/* ------------------------------------------------------------ editor + log toolbar */
+
+.nk-toolbar {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--nk-sp);
+	margin: 0 0 12px;
+}
+.nk-toolbar .nk-grow { flex: 1 1 240px; min-width: 0; }
+.nk-toolbar select,
+.nk-toolbar input[type="search"],
+.nk-toolbar input[type="text"] { width: 100%; min-width: 0; margin: 0; }
+.nk-toolbar .btn { margin: 0 !important; }
+.nk-toolbar label.nk-check {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	margin: 0;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-base);
+	white-space: nowrap;
+	cursor: pointer;
+}
+.nk-toolbar label.nk-check input { margin: 0; }
+.nk-select-auto { width: auto !important; flex: 0 0 auto; }
+
+.nk-fileinfo {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 6px 14px;
+	margin: 0 0 10px;
+	color: var(--nk-dim);
+	font-size: var(--nk-fs-sm);
+}
+.nk-fileinfo code { font-family: var(--nk-mono); color: var(--nk-text); word-break: break-all; }
+
+/* segmented switch (log source) */
+.nk-seg {
+	display: inline-flex;
+	gap: 2px;
+	padding: 3px;
+	border-radius: calc(var(--nk-r) + 3px);
+	background: var(--v-seg-bg, var(--nk-bg-sunk));
+}
+.nk-seg > button {
+	height: calc(var(--nk-ctl-h) - 6px);
+	margin: 0;
+	padding: 0 12px;
+	border: 0;
+	border-radius: var(--nk-r);
+	background: transparent;
+	color: var(--nk-dim);
+	font: inherit;
+	font-size: var(--nk-fs-base);
+	font-weight: 500;
+	cursor: pointer;
+}
+.nk-seg > button:hover { color: var(--nk-text); }
+.nk-seg > button[aria-pressed="true"] {
+	background: var(--v-seg-on, var(--nk-bg));
+	box-shadow: var(--v-seg-on-ring, 0 1px 2px rgba(0, 0, 0, .12));
+	color: var(--nk-accent);
+	font-weight: 600;
+}
+
+/* code / log surface */
+.nk-code {
+	display: block;
+	width: 100%;
+	min-height: 360px;
+	height: 62vh;
+	margin: 0;
+	padding: 12px 14px;
+	border: 1px solid var(--nk-line);
+	border-radius: var(--nk-r);
+	background: var(--nk-bg-soft);
+	color: var(--nk-text);
+	font-family: var(--nk-mono);
+	font-size: 12.5px;
+	line-height: 1.6;
+	tab-size: 2;
+	white-space: pre;
+	overflow: auto;
+	resize: vertical;
+}
+textarea.nk-code:focus {
+	outline: none;
+	border-color: var(--v-focus, var(--nk-accent));
+	box-shadow: 0 0 0 1px var(--v-focus, var(--nk-accent));
+}
+textarea.nk-code[disabled] { opacity: .6; }
+
+.nk-log { white-space: normal; padding: 6px 0; }
+.nk-log-line {
+	display: grid;
+	grid-template-columns: 9.5em 5.5em minmax(0, 1fr);
+	gap: 10px;
+	padding: 1px 14px;
+	white-space: pre-wrap;
+	word-break: break-word;
+}
+.nk-log-line:hover { background: var(--v-hover, var(--nk-bg-sunk)); }
+.nk-log-time { color: var(--nk-faint); white-space: nowrap; }
+.nk-log-tag { color: var(--nk-dim); font-weight: 600; text-transform: uppercase; font-size: 11px; line-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.nk-log-line.is-warn .nk-log-tag,
+.nk-log-line.is-warn .nk-log-msg { color: var(--nk-warn); }
+.nk-log-line.is-err { background: color-mix(in srgb, var(--nk-err-soft) 55%, transparent); }
+.nk-log-line.is-err .nk-log-tag,
+.nk-log-line.is-err .nk-log-msg { color: var(--nk-err); }
+.nk-log-line.is-debug .nk-log-msg { color: var(--nk-dim); }
+.nk-log-line.is-raw { grid-template-columns: minmax(0, 1fr); }
+.nk-log-empty { padding: 40px 14px; color: var(--nk-faint); text-align: center; font-family: inherit; }
+.nk-log-foot {
+	display: flex;
+	flex-wrap: wrap;
+	justify-content: space-between;
+	gap: 8px;
+	margin: 8px 0 0;
+	color: var(--nk-faint);
+	font-size: var(--nk-fs-sm);
+}
+
+.nk-dirty { color: var(--nk-warn); font-weight: 600; }
+
+@media (max-width: 640px) {
+	.nk-file { grid-template-columns: minmax(0, 1fr); }
+	.nk-file .nk-actions { justify-content: flex-start; }
+	.nk-log-line { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 4px 14px; }
+	.nk-log-tag { line-height: 1.6; }
+	.nk-code { height: 55vh; }
+}
