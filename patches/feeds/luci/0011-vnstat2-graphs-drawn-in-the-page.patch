+	function show(i) {
+		const s = slots[i];
+		if (active) active.classList.remove('active');
+		active = plot.children[i + 3];   // after the three grid lines
+		if (active) active.classList.add('active');
+		dom.content(readout, [ E('strong', {}, label(s.start, unit, true)) ].concat(legend(s), [
+			E('span', {}, _('Total') + ' ' + fmtBytes(s.rx + s.tx)),
+			E('span', {}, fmtRate(s.rx + s.tx, s.secs))
+		]));
+	}
+
+	[ 0, .5, 1 ].forEach(function(f) {
+		plot.appendChild(E('div', { 'class': 'vn-grid', 'style': 'bottom:%.1f%%'.format(f * 100) }));
+		yaxis.appendChild(E('span', { 'style': 'bottom:%.1f%%'.format(f * 100) }, f ? fmtBytes(max * f) : '0'));
+	});
+
+	slots.forEach(function(s, i) {
+		const tot = s.rx + s.tx;
+		plot.appendChild(E('div', {
+			'class': 'vn-slot',
+			'title': '%s\n%s: %s\n%s: %s\n%s'.format(label(s.start, unit, true), _('RX'), fmtBytes(s.rx), _('TX'), fmtBytes(s.tx), fmtRate(tot, s.secs)),
+			'mouseenter': function() { show(i); },
+			'click': function() { show(i); }
+		}, E('div', { 'class': tot ? 'vn-bar nz' : 'vn-bar', 'style': 'height:%.2f%%'.format(tot / max * 100) }, [
+			E('div', { 'class': 'vn-tx', 'style': 'height:%.2f%%'.format(tot ? s.tx / tot * 100 : 0) }),
+			E('div', { 'class': 'vn-rx', 'style': 'height:%.2f%%'.format(tot ? s.rx / tot * 100 : 0) })
+		])));
+		xaxis.appendChild(E('div', {}, ticked(s, i, n, unit) ? E('span', {}, label(s.start, unit, false)) : []));
 	});
+
+	plot.addEventListener('mouseleave', function() { show(n - 1); });
+	show(n - 1);
+
+	return E('div', { 'class': 'vn-chart' }, [
+		title ? E('div', { 'class': 'vn-chart-title' }, title) : '',
+		readout,
+		E('div', { 'class': 'vn-wrap' }, [ yaxis, E('div', { 'class': 'vn-main' }, [ plot, xaxis ]) ])
+	]);
 }
 
