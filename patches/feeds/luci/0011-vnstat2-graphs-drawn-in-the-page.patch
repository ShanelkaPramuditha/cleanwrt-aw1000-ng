+	switch (unit) {
+	case 'minute': return d.getUTCMinutes() == 0;
+	case 'hour': return d.getUTCHours() % 6 == 0;
+	case 'day': return (n - 1 - i) % 5 == 0;
+	case 'month': return n <= 12 || (n - 1 - i) % 2 == 0;
+	default: return true;
+	}
