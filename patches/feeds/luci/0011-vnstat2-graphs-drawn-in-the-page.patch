+
+// a round top for the scale, in binary units: 1, 2, 2.5, 5 x 1024^k (and x10, x100)
+function niceMax(v) {
+	let p = 1;
+	while (v / p >= 1024) p *= 1024;
+	const m = v / p;
+	for (const c of [ 1, 2, 2.5, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 1024 ])
+		if (m <= c) return c * p;
+	return 1024 * p;
