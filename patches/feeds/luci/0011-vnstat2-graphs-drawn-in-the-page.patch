+/* --- time: vnstat gives each entry's router-local date and time. They are
+   kept as wall-clock values (built with Date.UTC and read back with getUTC*),
+   so the labels are the router's own times and a step is never bent by the
+   browser's time zone or a daylight-saving change. */
+
+function stamp(o) {
+	const d = (o && o.date) || {}, t = (o && o.time) || {};
+	return Date.UTC(d.year || 1970, (d.month || 1) - 1, d.day || 1, t.hour || 0, t.minute || 0);
+}
+
+function floorTo(ms, unit, step) {
+	const d = new Date(ms), Y = d.getUTCFullYear(), M = d.getUTCMonth(), D = d.getUTCDate(), h = d.getUTCHours(), m = d.getUTCMinutes();
+	switch (unit) {
+	case 'minute': return Date.UTC(Y, M, D, h, m - m % step);
+	case 'hour': return Date.UTC(Y, M, D, h);
+	case 'day': return Date.UTC(Y, M, D);
+	case 'month': return Date.UTC(Y, M, 1);
+	default: return Date.UTC(Y, 0, 1);
+	}
+}
+
+function addTo(ms, unit, n) {
+	const d = new Date(ms), Y = d.getUTCFullYear(), M = d.getUTCMonth(), D = d.getUTCDate();
+	switch (unit) {
+	case 'minute': return ms + n * 60000;
+	case 'hour': return ms + n * 3600000;
+	case 'day': return Date.UTC(Y, M, D + n);
+	case 'month': return Date.UTC(Y, M + n, 1);
+	default: return Date.UTC(Y + n, 0, 1);
+	}
+}
+
+function dateText(ms, opts) {
+	return new Date(ms).toLocaleDateString(undefined, Object.assign({ timeZone: 'UTC' }, opts));
+}
+
+function label(ms, unit, long) {
+	const d = new Date(ms), hm = '%02d:%02d'.format(d.getUTCHours(), d.getUTCMinutes());
+	switch (unit) {
+	case 'minute':
+	case 'hour': return long ? dateText(ms, { day: 'numeric', month: 'short' }) + ' ' + hm : hm;
+	case 'day': return long ? dateText(ms, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : dateText(ms, { day: 'numeric', month: 'short' });
+	case 'month': return (long || d.getUTCMonth() == 0) ? dateText(ms, { month: 'short', year: 'numeric' }) : dateText(ms, { month: 'short' });
+	default: return String(d.getUTCFullYear());
+	}
