+// the newest `count` slots of one vnstat table, with the slots vnstat has no
+// entry for (no traffic) as zeros. The newest slot is still running, so its
+// rate is taken over the time so far.
+function series(info, mode, count) {
+	const p = PERIODS[mode], list = (info.traffic && info.traffic[p.key]) || [], byStart = new Map();
+	const updated = stamp(info.updated), created = stamp(info.created);
+	let last = floorTo(updated, p.unit, p.step), first = last;
+
+	list.forEach(function(e) {
+		const t = floorTo(stamp(e), p.unit, p.step);
+		byStart.set(t, e);
+		if (t > last) last = t;
+		if (t < first) first = t;
+	});
+
+	if (count == null) count = p.slots;
+	if (!count) count = new Date(last).getUTCFullYear() - new Date(first).getUTCFullYear() + 1;
+
+	const out = [];
+	for (let i = 0, t = last; i < count; i++, t = addTo(t, p.unit, -p.step)) {
+		const e = byStart.get(t), end = addTo(t, p.unit, p.step);
+		// nothing before the interface was added: no row of empty slots for it
+		if (out.length && end <= created && !e) break;
+		out.unshift({
+			start: t,
+			rx: e ? e.rx : 0,
+			tx: e ? e.tx : 0,
+			secs: (Math.min(end, Math.max(updated, t + 60000)) - t) / 1000
 		});
+	}
+	return out;
+}
