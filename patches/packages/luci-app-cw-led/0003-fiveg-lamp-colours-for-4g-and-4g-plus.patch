+# The 5G lamp learned 4G and 4G+ colours. A config written before that has no
+# 'fiveg' section; the daemon falls back to the same defaults, and the section is
+# added once so the page has something to show and save.
+if uci -q get cw-led.global >/dev/null && ! uci -q get cw-led.fiveg >/dev/null; then
+	uci -q batch <<-EOF
